# Ограничения DPAA для Colorlight i5 (LFE5U-25F-6BG381) + та же плата расширения.
# SITE "???" заменить на выводы ПЛИС по распиновке платы расширения (PMOD P1..P6)
# и модуля i9 (генератор 25 МГц, светодиод). Пока остаётся хоть один "???",
# make BOARD=i9 откажется собирать битстрим — это защита от неверной распиновки.
# Рекомендуемая раскладка по PMOD: P1 — BCLK, LRCLK, MON_SD, UART ESP32;
# P2, P3 — TXD0..15; P4, P5 — MIC0..15; P6 — CAL, USB-UART, кнопка.

LOCATE COMP "clk25" SITE "???";      # генератор 25 МГц на модуле i9
IOBUF PORT "clk25" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk25" 25 MHZ;
LOCATE COMP "led" SITE "???";        # светодиод модуля
IOBUF PORT "led" IO_TYPE=LVCMOS33;

LOCATE COMP "bclk" SITE "???";
IOBUF PORT "bclk" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=SLOW;
LOCATE COMP "lrclk" SITE "???";
IOBUF PORT "lrclk" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=SLOW;
LOCATE COMP "mon_sd" SITE "???";
IOBUF PORT "mon_sd" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=SLOW;

LOCATE COMP "txd[0]" SITE "???";
IOBUF PORT "txd[0]" IO_TYPE=LVCMOS33 DRIVE=8 SLEWRATE=SLOW;
